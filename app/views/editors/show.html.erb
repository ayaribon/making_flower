<% content_for :head do %>
  <%= stylesheet_link_tag "/fonts/dela-gothic-one/400.css" %>
  <%= stylesheet_link_tag "/fonts/rocknroll-one/400.css" %>
  <%= stylesheet_link_tag "/fonts/mochiy-pop-one/400.css" %>
  <%= stylesheet_link_tag "/fonts/zen-kaku-gothic-new/500.css" %>
  <%= stylesheet_link_tag "/fonts/zen-kaku-gothic-new/900.css" %>
<% end %>

<main
  class="studio"
  data-controller="canvas-editor"
  data-action="keydown@window->canvas-editor#onKeydown"
  data-canvas-editor-width-value="<%= @width %>"
  data-canvas-editor-height-value="<%= @height %>">
  <!-- 比率を選ぶ画面（最初に出す。ヘッダーのサイズを押すと、また開く） -->
  <div class="studio-ratio-picker" data-canvas-editor-target="ratioPicker">
    <div class="studio-ratio-card">
      <h2>どのサイズで作る？</h2>
      <div class="studio-ratio-list">
        <button type="button" class="studio-ratio-option"
          data-action="click->canvas-editor#chooseRatio"
          data-canvas-editor-ratio-param="16:9">
          <span class="studio-ratio-shape is-wide"></span>
          <strong>16:9</strong>
          <small>YouTubeサムネ・配信背景<br>1280×720</small>
        </button>
        <button type="button" class="studio-ratio-option"
          data-action="click->canvas-editor#chooseRatio"
          data-canvas-editor-ratio-param="9:16">
          <span class="studio-ratio-shape is-tall"></span>
          <strong>9:16</strong>
          <small>ショート・TikTok・縦配信<br>1080×1920</small>
        </button>
        <button type="button" class="studio-ratio-option"
          data-action="click->canvas-editor#chooseRatio"
          data-canvas-editor-ratio-param="1:1">
          <span class="studio-ratio-shape is-square"></span>
          <strong>1:1</strong>
          <small>X・インスタの告知<br>1080×1080</small>
        </button>
      </div>
      <button type="button" class="studio-ratio-cancel"
        data-canvas-editor-target="ratioClose"
        data-action="click->canvas-editor#closeRatioPicker" hidden>このままにする</button>
    </div>
  </div>

  <header class="studio-header">
    <h1 class="studio-logo">Koto<span>Bouquet</span> <small>✦</small></h1>
    <div class="studio-header-actions">
      <button type="button" class="studio-history-button" title="元に戻す（Ctrl+Z）"
        data-canvas-editor-target="undoButton"
        data-action="click->canvas-editor#undo" disabled>↩️<span>戻す</span></button>
      <button type="button" class="studio-history-button" title="進める（Ctrl+Shift+Z）"
        data-canvas-editor-target="redoButton"
        data-action="click->canvas-editor#redo" disabled>↪️<span>進める</span></button>
      <button type="button" class="studio-history-button is-reset" title="全部消す"
        data-action="click->canvas-editor#resetCanvas">🗑️<span>リセット</span></button>
      <button type="button" class="studio-size-badge"
        data-canvas-editor-target="sizeBadge"
        data-action="click->canvas-editor#openRatioPicker"><%= @width %> × <%= @height %> ▾</button>
    </div>
  </header>

  <section class="studio-stage">
    <div class="studio-canvas-frame" data-canvas-editor-target="frame">
      <canvas data-canvas-editor-target="canvas"></canvas>
    </div>
  </section>

  <footer class="studio-footer">
    <div class="studio-panel" data-canvas-editor-target="textPanel" hidden>
      <div class="studio-panel-header">
        <span>テキストを選択中</span>
        <div class="studio-panel-actions">
          <button
            type="button"
            class="studio-panel-lock"
            data-canvas-editor-target="lockButton"
            data-action="click->canvas-editor#toggleLock">🔓 ロック</button>
          <button
            type="button"
            class="studio-panel-delete"
            data-action="click->canvas-editor#deleteSelected">
            削除
          </button>
          <button
            type="button"
            class="studio-panel-close"
            data-action="click->canvas-editor#deselect">
            閉じる
          </button>
        </div>
      </div>
      
      <div class="studio-tabs">
        <button type="button" class="studio-tab is-active"
          data-canvas-editor-target="tab" data-tab="style"
          data-action="click->canvas-editor#switchTab"
          data-canvas-editor-tab-param="style">スタイル</button>
        <button type="button" class="studio-tab"
          data-canvas-editor-target="tab" data-tab="fill"
          data-action="click->canvas-editor#switchTab"
          data-canvas-editor-tab-param="fill">文字色</button>
        <button type="button" class="studio-tab"
          data-canvas-editor-target="tab" data-tab="stroke"
          data-action="click->canvas-editor#switchTab"
          data-canvas-editor-tab-param="stroke">フチ</button>
        <button type="button" class="studio-tab"
          data-canvas-editor-target="tab" data-tab="shadow"
          data-action="click->canvas-editor#switchTab"
          data-canvas-editor-tab-param="shadow">影</button>
      </div>

      <!-- スタイル -->
      <div class="studio-tab-page" data-canvas-editor-target="tabPage" data-tab="style">
        <div class="studio-style-list">
          <button type="button" class="studio-style-button style-preview-impact"
            data-action="click->canvas-editor#applyStyle"
            data-canvas-editor-style-param="impact">🔥 インパクト</button>
          <button type="button" class="studio-style-button style-preview-gaming"
            data-action="click->canvas-editor#applyStyle"
            data-canvas-editor-style-param="gaming">🎮 ゲーム実況</button>
          <button type="button" class="studio-style-button style-preview-yurukawa"
            data-action="click->canvas-editor#applyStyle"
            data-canvas-editor-style-param="yurukawa">🌸 ゆるかわ</button>
          <button type="button" class="studio-style-button style-preview-neon"
            data-action="click->canvas-editor#applyStyle"
            data-canvas-editor-style-param="neon">✨ ネオン</button>
          <button type="button" class="studio-style-button style-preview-news"
            data-action="click->canvas-editor#applyStyle"
            data-canvas-editor-style-param="news">📢 ニュース速報</button>
        </div>

        <div class="studio-settings">
          <label class="studio-setting studio-setting-size">
            <span>サイズ <strong data-canvas-editor-target="sizeValue">96</strong>px</span>
            <input
              type="range"
              min="24"
              max="300"
              step="1"
              data-canvas-editor-target="sizeInput"
              data-action="input->canvas-editor#changeSize">
          </label>
        </div>
      </div>

      <!-- 文字色 -->
      <div class="studio-tab-page" data-canvas-editor-target="tabPage" data-tab="fill" hidden>
        <div class="studio-segment">
          <button type="button" class="studio-segment-button is-active"
            data-canvas-editor-target="fillModeButton" data-mode="solid"
            data-action="click->canvas-editor#changeFillMode"
            data-canvas-editor-mode-param="solid">単色</button>
          <button type="button" class="studio-segment-button"
            data-canvas-editor-target="fillModeButton" data-mode="gradient"
            data-action="click->canvas-editor#changeFillMode"
            data-canvas-editor-mode-param="gradient">グラデーション</button>
        </div>

        <div class="studio-settings">
          <label class="studio-setting">
            <span data-canvas-editor-target="colorLabel">文字色</span>
            <input
              type="color"
              data-canvas-editor-target="colorInput"
              data-action="input->canvas-editor#changeFill">
          </label>

          <label class="studio-setting" data-canvas-editor-target="gradientOnly" hidden>
            <span>色2</span>
            <input
              type="color"
              data-canvas-editor-target="color2Input"
              data-action="input->canvas-editor#changeFill">
          </label>

          <label class="studio-setting" data-canvas-editor-target="gradientOnly" hidden>
            <span>向き</span>
            <select
              data-canvas-editor-target="directionInput"
              data-action="change->canvas-editor#changeFill">
              <option value="vertical">縦（上→下）</option>
              <option value="horizontal">横（左→右）</option>
              <option value="diagonal">ななめ</option>
            </select>
          </label>
        </div>
      </div>

      <!-- フチ（次の回で中身を入れる） -->
      <div class="studio-tab-page" data-canvas-editor-target="tabPage" data-tab="stroke" hidden>
        <div class="studio-settings">
          <label class="studio-setting">
            <span>フチの色</span>
            <input
              type="color"
              data-canvas-editor-target="strokeColorInput"
              data-action="input->canvas-editor#changeStroke">
          </label>

          <label class="studio-setting studio-setting-size">
            <span>太さ <strong data-canvas-editor-target="strokeWidthValue">0</strong></span>
            <input
              type="range"
              min="0"
              max="40"
              step="1"
              data-canvas-editor-target="strokeWidthInput"
              data-action="input->canvas-editor#changeStroke">
          </label>
        </div>
        <p class="studio-tab-note">太さを 0 にするとフチなしになります</p>
      </div>

      <!-- 影（次の回で中身を入れる） -->
      <div class="studio-tab-page" data-canvas-editor-target="tabPage" data-tab="shadow" hidden>
        <div class="studio-settings studio-settings-wrap">
          <label class="studio-setting">
            <span>影の色</span>
            <input
              type="color"
              data-canvas-editor-target="shadowColorInput"
              data-action="input->canvas-editor#changeShadow">
          </label>

          <label class="studio-setting studio-setting-size">
            <span>濃さ <strong data-canvas-editor-target="shadowOpacityValue">0</strong>%</span>
            <input
              type="range" min="0" max="100" step="1"
              data-canvas-editor-target="shadowOpacityInput"
              data-action="input->canvas-editor#changeShadow">
          </label>

          <label class="studio-setting studio-setting-size">
            <span>ぼかし <strong data-canvas-editor-target="shadowBlurValue">0</strong></span>
            <input
              type="range" min="0" max="80" step="1"
              data-canvas-editor-target="shadowBlurInput"
              data-action="input->canvas-editor#changeShadow">
          </label>

          <label class="studio-setting studio-setting-size">
            <span>横ずれ <strong data-canvas-editor-target="shadowXValue">0</strong></span>
            <input
              type="range" min="-40" max="40" step="1"
              data-canvas-editor-target="shadowXInput"
              data-action="input->canvas-editor#changeShadow">
          </label>

          <label class="studio-setting studio-setting-size">
            <span>縦ずれ <strong data-canvas-editor-target="shadowYValue">0</strong></span>
            <input
              type="range" min="-40" max="40" step="1"
              data-canvas-editor-target="shadowYInput"
              data-action="input->canvas-editor#changeShadow">
          </label>
        </div>
        <p class="studio-tab-note">濃さを 0 にすると影なしになります。ずれ0・ぼかし大きめで「光る」感じになります</p>
      </div>
    </div>

    <!-- 背景パネル -->
    <div class="studio-panel" data-canvas-editor-target="bgPanel" hidden>
      <div class="studio-panel-header">
        <span>背景</span>
        <div class="studio-panel-actions">
          <button
            type="button"
            class="studio-panel-close"
            data-action="click->canvas-editor#closeBackgroundPanel">
            閉じる
          </button>
        </div>
      </div>

      <div class="studio-segment">
        <button type="button" class="studio-segment-button is-active"
          data-canvas-editor-target="bgModeButton" data-mode="solid"
          data-action="click->canvas-editor#changeBgMode"
          data-canvas-editor-mode-param="solid">単色</button>
        <button type="button" class="studio-segment-button"
          data-canvas-editor-target="bgModeButton" data-mode="gradient"
          data-action="click->canvas-editor#changeBgMode"
          data-canvas-editor-mode-param="gradient">グラデーション</button>
      </div>

      <div class="studio-settings">
        <label class="studio-setting">
          <span data-canvas-editor-target="bgColorLabel">背景色</span>
          <input
            type="color"
            data-canvas-editor-target="bgColorInput"
            data-action="input->canvas-editor#changeBackground">
        </label>

        <label class="studio-setting" data-canvas-editor-target="bgGradientOnly" hidden>
          <span>色2</span>
          <input
            type="color"
            data-canvas-editor-target="bgColor2Input"
            data-action="input->canvas-editor#changeBackground">
        </label>

        <label class="studio-setting" data-canvas-editor-target="bgGradientOnly" hidden>
          <span>向き</span>
          <select
            data-canvas-editor-target="bgDirectionInput"
            data-action="change->canvas-editor#changeBackground">
            <option value="vertical">縦（上→下）</option>
            <option value="horizontal">横（左→右）</option>
            <option value="diagonal">ななめ</option>
          </select>
        </label>
      </div>

      <div class="studio-bg-images">
        <span class="studio-bg-images-label">背景画像</span>
        <div class="studio-bg-image-list">
          <button type="button" class="studio-bg-thumb studio-bg-thumb-none"
            data-action="click->canvas-editor#clearBackgroundImage">なし</button>
          <button type="button" class="studio-bg-thumb studio-my-add"
            data-action="click->canvas-editor#pickMyImage"
            data-canvas-editor-kind-param="background">📷<br>自分の画像</button>
          <input type="file" accept="image/*" hidden
            data-canvas-editor-target="bgFileInput"
            data-action="change->canvas-editor#onMyImageSelected"
            data-kind="background">
          <span class="studio-my-list" data-canvas-editor-target="myBgList"></span>
          <% [
            ["burst", "集中線"],
            ["neon-grid", "ネオングリッド"],
            ["pastel-dots", "パステル水玉"]
          ].each do |key, label| %>
            <button type="button" class="studio-bg-thumb"
              title="<%= label %>"
              data-action="click->canvas-editor#setBackgroundImage"
              data-canvas-editor-src-param="/backgrounds/<%= key %>.svg">
              <img src="/backgrounds/<%= key %>.svg" alt="<%= label %>">
            </button>
          <% end %>
        </div>
        <p class="studio-tab-note">背景画像を選ぶと、背景色の上に重なります</p>
      </div>
    </div>

    <!-- 部品パネル（部品を追加する） -->
    <div class="studio-panel" data-canvas-editor-target="partsPanel" hidden>
      <div class="studio-panel-header">
        <span>部品を追加 <em class="studio-replace-hint" data-canvas-editor-target="replaceHint" hidden>📷 の画像を選ぶと「ここに画像」と入れ替わります</em></span>
        <div class="studio-panel-actions">
          <button type="button" class="studio-panel-close"
            data-action="click->canvas-editor#closePartsPanel">閉じる</button>
        </div>
      </div>

      <div class="studio-bg-image-list">
        <button type="button" class="studio-part-thumb studio-my-add"
          data-action="click->canvas-editor#pickMyImage"
          data-canvas-editor-kind-param="part">📷<br>自分の<br>画像</button>
        <input type="file" accept="image/*" hidden
          data-canvas-editor-target="partFileInput"
          data-action="change->canvas-editor#onMyImageSelected"
          data-kind="part">
        <span class="studio-my-list" data-canvas-editor-target="myPartList"></span>
        <% [
          ["bubble", "吹き出し"],
          ["star", "星"],
          ["heart", "ハート"],
          ["arrow", "矢印"],
          ["burst-label", "ギザギザ"],
          ["frame", "枠"]
        ].each do |key, label| %>
          <button type="button" class="studio-part-thumb"
            title="<%= label %>"
            data-action="click->canvas-editor#addPart"
            data-canvas-editor-src-param="/parts/<%= key %>.svg">
            <img src="/parts/<%= key %>.svg" alt="<%= label %>">
          </button>
        <% end %>
      </div>
      <p class="studio-tab-note">自分の画像はこの端末のブラウザの中だけに保存されます（サーバーには送りません）。長押し・右クリックの「×」で一覧から消せます</p>
    </div>

    <!-- 部品を選んでいるときのパネル -->
    <div class="studio-panel" data-canvas-editor-target="partPanel" hidden>
      <div class="studio-panel-header">
        <span>部品を選択中</span>
        <div class="studio-panel-actions">
          <button
            type="button"
            class="studio-panel-lock"
            data-canvas-editor-target="lockButton"
            data-action="click->canvas-editor#toggleLock">🔓 ロック</button>
          <button type="button" class="studio-panel-delete"
            data-action="click->canvas-editor#deleteSelected">削除</button>
          <button type="button" class="studio-panel-close"
            data-action="click->canvas-editor#deselect">閉じる</button>
        </div>
      </div>

      <div class="studio-settings">
        <label class="studio-setting studio-setting-size">
          <span>透明度 <strong data-canvas-editor-target="partOpacityValue">100</strong>%</span>
          <input type="range" min="10" max="100" step="1"
            data-canvas-editor-target="partOpacityInput"
            data-action="input->canvas-editor#changePartOpacity">
        </label>
        <button type="button" class="studio-panel-close"
          data-action="click->canvas-editor#flipPart">左右反転</button>
        <button type="button" class="studio-panel-close studio-replace-button"
          data-canvas-editor-target="replaceButton" hidden
          data-action="click->canvas-editor#replacePlaceholder">📷 自分の画像に差し替え</button>
      </div>
    </div>

    <!-- エフェクトパネル（フィルター・フレーム） -->
    <div class="studio-panel" data-canvas-editor-target="effectsPanel" hidden>
      <div class="studio-panel-header">
        <span>エフェクト</span>
        <div class="studio-panel-actions">
          <button type="button" class="studio-panel-close"
            data-action="click->canvas-editor#closeEffectsPanel">閉じる</button>
        </div>
      </div>

      <div class="studio-tabs">
        <button type="button" class="studio-tab is-active"
          data-canvas-editor-target="effectTab" data-tab="filter"
          data-action="click->canvas-editor#switchEffectTab"
          data-canvas-editor-tab-param="filter">フィルター</button>
        <button type="button" class="studio-tab"
          data-canvas-editor-target="effectTab" data-tab="frame"
          data-action="click->canvas-editor#switchEffectTab"
          data-canvas-editor-tab-param="frame">フレーム</button>
      </div>

      <div class="studio-tab-page" data-canvas-editor-target="effectPage" data-tab="filter">
        <% [
          ["scanline", "📺", "走査線", 50],
          ["dots", "🔵", "ドット", 40],
          ["sparkle", "✨", "キラキラ", 60],
          ["vignette", "🌑", "周りを暗く", 50],
          ["tint", "🎨", "色かぶり", 40]
        ].each do |key, icon, label, default| %>
          <div class="studio-effect-row">
            <button type="button" class="studio-effect-toggle"
              data-canvas-editor-target="effectToggle" data-key="<%= key %>"
              data-action="click->canvas-editor#toggleFilter"
              data-canvas-editor-key-param="<%= key %>"><%= icon %> <%= label %></button>
            <input type="range" min="10" max="100" step="1" value="<%= default %>"
              data-canvas-editor-target="effectStrength" data-key="<%= key %>"
              data-action="input->canvas-editor#changeFilterStrength"
              data-canvas-editor-key-param="<%= key %>">
            <% if key == "tint" %>
              <input type="color" value="#7b5cff"
                data-canvas-editor-target="tintInput"
                data-action="input->canvas-editor#changeTint">
            <% end %>
          </div>
        <% end %>
        <p class="studio-tab-note">押すとON／OFF。いくつでも重ねられて、スライダーで強さを変えられます</p>
      </div>

      <div class="studio-tab-page" data-canvas-editor-target="effectPage" data-tab="frame" hidden>
        <div class="studio-frame-list">
          <% [
            ["none", "🚫", "なし"],
            ["pixel", "👾", "ピクセル"],
            ["ribbon", "🎀", "リボン"],
            ["sparkle", "💫", "キラキラ"],
            ["monitor", "🖥️", "モニター"]
          ].each do |key, icon, label| %>
            <button type="button" class="studio-frame-button<%= " is-active" if key == "none" %>"
              data-canvas-editor-target="frameButton" data-key="<%= key %>"
              data-action="click->canvas-editor#setFrame"
              data-canvas-editor-frame-param="<%= key %>">
              <span><%= icon %></span><%= label %>
            </button>
          <% end %>
        </div>
        <p class="studio-tab-note">フレームは1つだけ。比率を変えてもフチに合わせて作り直します</p>
      </div>
    </div>

    <!-- テンプレパネル -->
    <div class="studio-panel" data-canvas-editor-target="templatesPanel" hidden>
      <div class="studio-panel-header">
        <span>テンプレート</span>
        <div class="studio-panel-actions">
          <button type="button" class="studio-panel-close"
            data-action="click->canvas-editor#closeTemplatesPanel">閉じる</button>
        </div>
      </div>
      <div class="studio-template-list" data-canvas-editor-target="templateList"></div>
      <p class="studio-tab-note">今のサイズに合うテンプレを表示しています。読み込んだあとは自由に編集できます</p>
    </div>

    <nav class="studio-toolbar">
      <button type="button" data-action="click->canvas-editor#addText">
        <span class="studio-toolbar-icon">✏️</span><span class="studio-toolbar-label">テキスト</span>
      </button>
      <button type="button" data-action="click->canvas-editor#togglePartsPanel">
        <span class="studio-toolbar-icon">🧸</span><span class="studio-toolbar-label">部品</span>
      </button>
      <button type="button" data-action="click->canvas-editor#toggleBackgroundPanel">
        <span class="studio-toolbar-icon">🖼️</span><span class="studio-toolbar-label">背景</span>
      </button>
      <button type="button" data-action="click->canvas-editor#toggleEffectsPanel">
        <span class="studio-toolbar-icon">✨</span><span class="studio-toolbar-label">エフェクト</span>
      </button>
      <button type="button" data-action="click->canvas-editor#toggleTemplatesPanel">
        <span class="studio-toolbar-icon">📋</span><span class="studio-toolbar-label">テンプレ</span>
      </button>
      <button type="button" class="is-soon" title="次の段階で追加">
        <span class="studio-toolbar-icon">💾</span><span class="studio-toolbar-label">書き出し</span>
      </button>
    </nav>
  </footer>
</main>
