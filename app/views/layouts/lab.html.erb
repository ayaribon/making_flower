<!DOCTYPE html>
<%# 🧪 /lab の 共通の 枠。本体の application.css は 読まない（lab の CSS は lab/lab.css に まとまる） %>
<html lang="ja">
  <head>
    <title>lab<%= " - #{content_for(:title)}" if content_for?(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "lab/lab", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="lab">
    <%= yield %>
  </body>
</html>
