<%# ✂️ 切り抜き動画をたのむ（フォーム → Discord）。見た目は app/assets/stylesheets/clip_requests.css %>
<div class="cr">
  <div class="cr-inner">
    <p class="cr-back"><%= link_to "🏠 メニューへ", root_path, data: { turbo: false } %></p>
    <h1 class="cr-title">✂️ 切り抜き動画をたのむ</h1>
    <p class="cr-lead">配信や動画の「ここを切り抜いてほしい！」を送ってね。切り抜き動画にして届けます。</p>

    <% if notice.present? %><p class="cr-flash cr-flash--ok" role="status"><%= notice %></p><% end %>
    <% if @last_closed&.status == "done" %>
      <div class="cr-flash cr-flash--ok cr-result">
        🎉 前にたのんだ切り抜きが、できあがったよ！
        <% if @last_closed.result_url.present? %><%= link_to "▶ 動画を見る", @last_closed.result_url, target: "_blank", rel: "noopener noreferrer" %><% end %>
      </div>
    <% elsif @last_closed&.status == "declined" %>
      <p class="cr-flash cr-flash--ng">🙏 前にたのんだ切り抜きは、ごめんね、今回はお断りになりました。また気軽にたのんでね</p>
    <% end %>

    <%# ⚠ あくまで「できたらいいな」で受け付けています、という注意 %>
    <div class="cr-note" role="note">
      <p class="cr-note__title">⚠ はじめに読んでね</p>
      <ul>
        <li>依頼は<b>「できたらいいな」</b>の気持ちで受け付けています。作れるかどうか・いつできるかは、そのときの手のあき具合しだいです（善処します…！）</li>
        <li><b>クオリティは保証できません。</b>仕上がりや編集の凝り具合が、思っていたのとちがうこともあります。ゆるしてね</li>
        <li>しめきりは目安として見ます。間に合わないこともあります</li>
        <li>内容によっては、お断りすることがあります（権利がむずかしいもの・長すぎるものなど）</li>
      </ul>
      <p class="cr-note__cheer">でも気軽にリクエストしてねっ！</p>
    </div>

    <% if flash[:alert].present? %><p class="cr-flash cr-flash--ng" role="alert"><%= flash[:alert] %></p><% end %>
    <% unless @configured %>
      <p class="cr-flash cr-flash--ng">⚠ いまは送れません。管理者に知らせてください</p>
    <% end %>

    <%= form_with model: @clip_request, url: clip_requests_path, local: true, class: "cr-form", data: { turbo: false } do |f| %>
      <% if @clip_request.errors.any? %>
        <div class="cr-errors" role="alert">
          <p>直してほしい所があります</p>
          <ul><% @clip_request.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
        </div>
      <% end %>

      <div class="cr-field">
        <%= f.label :video_url, "動画のリンク" %><span class="cr-req">必須</span>
        <%= f.url_field :video_url, placeholder: "https://www.youtube.com/watch?v=…", maxlength: 500, required: true, inputmode: "url" %>
        <p class="cr-help">YouTube・Twitch などの配信のリンク。<b>手元の mp4 を送りたいとき</b>は、Googleドライブに入れて、共有を「リンクを知っている全員が閲覧可」にしてリンクを貼ってね（リンクは管理者だけが見ます。終わったら共有を止めてOK）</p>
      </div>

      <div class="cr-field">
        <%= f.label :scenes, "切り抜きたい所" %><span class="cr-req">必須</span>
        <%= f.text_area :scenes, rows: 4, maxlength: 1000, required: true, placeholder: "例）1:23:40〜1:25:10　ゲームで大笑いしたところ\n2:05:00〜2:06:30　歌の最後のサビ" %>
        <p class="cr-help">はじまり〜おわりの時間と、どんな場面か。いくつでもOK</p>
      </div>

      <div class="cr-row">
        <div class="cr-field">
          <span class="cr-label">形</span>
          <div class="cr-chips">
            <% ClipRequest::ORIENTATIONS.each do |k, label| %>
              <label class="cr-chip"><%= f.radio_button :orientation, k %><span><%= label %></span></label>
            <% end %>
          </div>
        </div>
        <div class="cr-field">
          <span class="cr-label">長さ</span>
          <div class="cr-chips">
            <% ClipRequest::LENGTHS.each do |k, label| %>
              <label class="cr-chip"><%= f.radio_button :length, k %><span><%= label %></span></label>
            <% end %>
          </div>
        </div>
        <div class="cr-field">
          <span class="cr-label">字幕</span>
          <div class="cr-chips">
            <% ClipRequest::SUBTITLES.each do |k, label| %>
              <label class="cr-chip"><%= f.radio_button :subtitles, k %><span><%= label %></span></label>
            <% end %>
          </div>
        </div>
      </div>

      <div class="cr-field">
        <%= f.label :title_idea, "タイトル案" %><span class="cr-opt">なくてもOK</span>
        <%= f.text_field :title_idea, maxlength: 100, placeholder: "例）【神回】まさかの逆転勝ち" %>
      </div>
      <div class="cr-field">
        <%= f.label :mood, "ふんいき" %><span class="cr-opt">なくてもOK</span>
        <%= f.text_field :mood, maxlength: 200, placeholder: "例）テンポよく・効果音多め／しっとり" %>
      </div>
      <div class="cr-field">
        <%= f.label :deadline, "しめきり" %><span class="cr-opt">なくてもOK</span>
        <%= f.date_field :deadline, min: Date.current %>
      </div>
      <div class="cr-field">
        <%= f.label :note, "メモ" %><span class="cr-opt">なくてもOK</span>
        <%= f.text_area :note, rows: 3, maxlength: 1000, placeholder: "ほかに伝えたいこと" %>
      </div>

      <div class="cr-field">
        <%= f.label :material_links, "📎 使っていい素材・画像" %><span class="cr-opt">あれば</span>
        <%= f.text_area :material_links, rows: 2, maxlength: 1000, placeholder: "例）https://drive.google.com/…（ロゴ・立ち絵・BGM など）" %>
        <p class="cr-help">切り抜きに使ってほしいロゴ・立ち絵・画像などがあれば、Googleドライブなどのリンクを貼ってね（共有は「リンクを知っている全員が閲覧可」に）。あとから<%= link_to "こちら", new_clip_material_path %>からでも送れます</p>
      </div>
      <%= render "clip_requests/image_picker", f: f, label: "🖼 画像をそのまま送る", note: "あれば" %>

      <label class="cr-check">
        <%= f.check_box :permission, {}, "1", "0" %>
        <span>自分の配信、または切り抜きの許可をもらった動画です。上の「⚠ はじめに読んでね」も読みました<span class="cr-req">必須</span></span>
      </label>

      <div class="cr-actions">
        <%= f.submit "✂️ 依頼を送る", class: "cr-submit", disabled: !@configured, data: { disable_with: "送っています…" } %>
      </div>
    <% end %>
  </div>
</div>
