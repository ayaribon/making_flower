<%# 👤 キャラメイク（はじまりのまち の アバター）。動きは controllers/avatar_maker_controller.js、見た目は app/assets/stylesheets/avatar.css %>
<div class="av" data-controller="avatar-maker"
     data-avatar-maker-avatar-value="<%= (current_user.avatar || {}).to_json %>"
     data-avatar-maker-url-value="<%= avatar_path %>"
     data-avatar-maker-account-value="<%= current_user.name %>"
     data-avatar-maker-human-url-value="<%= @human_url %>"
     data-avatar-maker-hair-urls-value="<%= (@hair_urls || {}).to_json %>"
     data-avatar-maker-layer-urls-value="<%= (@layer_urls || {}).to_json %>"
     data-avatar-maker-back-value="<%= root_path %>">
  <div class="av-inner">
    <header class="av-bar">
      <a class="av-back" href="<%= root_path %>" data-turbo="false">🏘️ まち へ</a>
      <h1 class="av-title">👤 キャラメイク</h1>
    </header>

    <div class="av-main">
      <div class="av-stage">
        <canvas class="av-preview" data-avatar-maker-target="preview" role="img" aria-label="じぶんの キャラ（タップで まわる・よこに なぞっても まわる）" tabindex="0"
                data-action="pointerdown->avatar-maker#dragStart pointermove->avatar-maker#dragMove pointerup->avatar-maker#dragEnd pointercancel->avatar-maker#dragEnd keydown->avatar-maker#turnKey"></canvas>
        <%# 🔄 むきを かえる（◀ ▶・キャラを タップ・よこに なぞる・← → キー）。⏸ で くるくる を とめる／うごかす %>
        <div class="av-turn" data-avatar-maker-target="turn" hidden>
          <button type="button" class="av-turn__btn" data-action="avatar-maker#turnLeft" aria-label="ひだりに まわす">◀</button>
          <button type="button" class="av-turn__btn av-turn__btn--spin" data-avatar-maker-target="spinButton" data-action="avatar-maker#toggleSpin" aria-pressed="true">⏸ くるくる</button>
          <button type="button" class="av-turn__btn" data-action="avatar-maker#turnRight" aria-label="みぎに まわす">▶</button>
        </div>
        <p class="av-name" data-avatar-maker-target="nameLabel"><%= current_user.display_label %></p>
        <%# 🏷️ 表示名（まち・あいさつ に 出る なまえ）。空なら ログインの 呼び名 %>
        <label class="av-msg">
          <span class="av-msg__label">🏷️ なまえ（まちに 出る）</span>
          <input class="av-msg__input" type="text" maxlength="<%= User::DISPLAY_NAME_MAX %>" data-avatar-maker-target="displayName"
                 data-action="input->avatar-maker#nameChanged"
                 value="<%= current_user.display_name %>" placeholder="<%= current_user.name %>" autocomplete="off">
        </label>
        <%# 💬 まちで キャラが ときどき 言う ことば（ほかの人にも 見える） %>
        <label class="av-msg">
          <span class="av-msg__label">💬 ひとこと</span>
          <input class="av-msg__input" type="text" maxlength="<%= User::AVATAR_MSG_MAX %>" data-avatar-maker-target="msg"
                 placeholder="まちで みんなに 見える ことば" autocomplete="off">
        </label>
        <div class="av-tools">
          <button type="button" class="av-tool" data-action="avatar-maker#random">🎲 おまかせ</button>
          <button type="button" class="av-tool" data-action="avatar-maker#reset">↩ もとにもどす</button>
        </div>
      </div>
      <%# えらぶところ（中身は avatar_sprite.js の 表から 作る） %>
      <div class="av-groups" data-avatar-maker-target="groups"></div>
    </div>

    <div class="av-save">
      <button type="button" class="av-save__btn" data-avatar-maker-target="save" data-action="avatar-maker#save">💾 これにする</button>
      <p class="av-save__status" data-avatar-maker-target="status" role="status" aria-live="polite"></p>
    </div>
  </div>
</div>
