<%# 🧑‍💼 Dettyan 育成ゲーム。動きは controllers/dettyan_game_controller.js、見た目は app/assets/stylesheets/dettyan.css %>
<div class="dt" data-controller="dettyan-game" data-dettyan-game-user-id-value="<%= current_user.id %>" data-dettyan-game-owner-value="<%= current_user.dettyan_owner? %>">
  <div class="dt-inner">
    <header class="dt-bar">
      <a class="dt-home-link" href="<%= root_path %>" data-turbo="false">🏠 メニュー</a>
      <h1 class="dt-title">Dettyan 育成ゲーム</h1>
      <div class="dt-sound">
        <button type="button" class="dt-icon-button" data-dettyan-game-target="soundButton" data-action="dettyan-game#toggleSoundPanel" aria-label="音の設定">🔊</button>
        <div class="dt-sound-panel" data-dettyan-game-target="soundPanel" hidden>
          <button type="button" data-dettyan-game-target="bgmToggle" data-action="dettyan-game#toggleBgm">🎵 BGM：オン</button>
          <button type="button" data-dettyan-game-target="seToggle" data-action="dettyan-game#toggleSe">🔔 こうかおん：オン</button>
        </div>
      </div>
    </header>

    <div class="dt-hud">
      <span class="dt-level" data-dettyan-game-target="level">Lv1</span>
      <span class="dt-money">💰 <span data-dettyan-game-target="money">0</span></span>
      <span class="dt-stat">げんき <span class="dt-meter"><span class="dt-meter__fill dt-meter__fill--genki" data-dettyan-game-target="genki"></span></span> <span class="dt-stat__num" data-dettyan-game-target="genkiNum"></span></span>
      <span class="dt-stat">ごきげん <span class="dt-meter"><span class="dt-meter__fill dt-meter__fill--gokigen" data-dettyan-game-target="gokigen"></span></span></span>
    </div>

    <div class="dt-stage">
      <canvas class="dt-room" data-dettyan-game-target="canvas" data-action="pointerdown->dettyan-game#tap" role="img" aria-label="事務所の部屋を歩く Dettyan"></canvas>
      <div class="dt-bubble" data-dettyan-game-target="bubble" hidden></div>
      <div class="dt-toast" data-dettyan-game-target="toast" role="status" hidden></div>
      <div class="dt-skip" data-dettyan-game-target="skip" hidden>タップで とばす ▶▶</div>

      <%# おせわのメニュー（Dettyan をタップすると出る） %>
      <div class="dt-care" data-dettyan-game-target="menu" hidden>
        <button type="button" data-action="dettyan-game#care" data-dettyan-game-kind-param="pet">🤚<span>なでる</span></button>
        <button type="button" data-action="dettyan-game#care" data-dettyan-game-kind-param="clean">🧹<span>そうじ</span></button>
        <button type="button" data-action="dettyan-game#care" data-dettyan-game-kind-param="talk">💬<span>はなす</span></button>
        <button type="button" data-action="dettyan-game#openBag">🍙<span>ごはん</span></button>
      </div>

      <%# ショップ・もちもの（中身は dettyan_foods.js の表から作る） %>
      <div class="dt-sheet" data-dettyan-game-target="sheet" hidden>
        <div class="dt-sheet__head">
          <span class="dt-sheet__title" data-dettyan-game-target="sheetTitle"></span>
          <span class="dt-sheet__money" data-dettyan-game-target="sheetMoney"></span>
          <button type="button" class="dt-sheet__close" data-action="dettyan-game#closeSheet" aria-label="とじる">✕</button>
        </div>
        <div class="dt-sheet__list" data-dettyan-game-target="sheetList"></div>
      </div>

      <%# はじめる画面（音が出ることを先に知らせる。タップで音が鳴り始める） %>
      <button type="button" class="dt-start" data-dettyan-game-target="start" data-action="dettyan-game#start">
        <span class="dt-start__text" data-dettyan-game-target="startText">よみこみ中…</span>
        <span class="dt-start__note" data-dettyan-game-target="startNote" hidden>※音が出ます（右上の🔊で消せます）</span>
      </button>
    </div>

    <div class="dt-actions">
      <button type="button" data-action="dettyan-game#openQuest">🗺️<span>ぼうけん</span></button>
      <button type="button" data-action="dettyan-game#openShop">🛒<span>ショップ</span></button>
      <button type="button" data-action="dettyan-game#openBag">🎒<span>もちもの</span></button>
      <button type="button" data-action="dettyan-game#openGear">👕<span>そうび</span></button>
    </div>

    <p class="dt-help">Dettyan をタップすると、おせわができるよ。<br>🗺️ ぼうけん は げんき を使って、すぐ帰ってくるよ。<br>見ていると、PC で作業したり 歌ったりするよ。</p>
  </div>
</div>
